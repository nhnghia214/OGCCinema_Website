@model OGCCinema.Models_Old.ReviewViewModel

@{
    ViewData["Title"] = "Đánh giá";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (TempData["PendingReview"] != null && (!User.Identity.IsAuthenticated || string.IsNullOrEmpty(@Context.Session.GetString("UserAuthenticated"))))
{
    <div class="alert alert-warning">Vui lòng đăng nhập để gửi đánh giá!</div>
}
<style>
    <link href="~/css/reviewview.css" rel="stylesheet" />
</style>



<div class="review-wrapper container mt-5">
    <div class="card shadow-lg p-4 rounded-4">
        <h3 class="text-center text-success mb-3">
            Chúng tôi luôn lắng nghe bạn! <i class="fas fa-smile-wink happy-icon"></i>
        </h3>
        <p class="text-center text-muted">
            Phản hồi của bạn giúp chúng tôi cải thiện tốt hơn. Cảm ơn bạn đã dành thời gian!
        </p>

        <!-- Tabs -->
        <ul class="nav nav-tabs justify-content-center" id="reviewTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="rap-tab" data-bs-toggle="tab" data-bs-target="#rap" type="button" role="tab">
                    Chất lượng rạp
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="nhanvien-tab" data-bs-toggle="tab" data-bs-target="#nhanvien" type="button" role="tab">
                    Nhân viên
                </button>
            </li>
        </ul>

        <div class="tab-content mt-4" id="reviewTabContent">
            <!-- Form Chất lượng rạp -->
            <div class="tab-pane fade show active" id="rap" role="tabpanel">
                <form id="rapForm" method="post" asp-action="SubmitRapReview" asp-controller="Reviews">
                    <input type="hidden" name="IdKhachHang" value="@(User.Identity.IsAuthenticated ? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value : 0)" />
                    <div class="mb-3">
                        <label class="form-label">Ý kiến của bạn về rạp</label>
                        <textarea class="form-control rounded-3" name="NoiDung" rows="6" placeholder="Hãy chia sẻ cảm nhận của bạn..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm">Gửi ngay</button>
                </form>
            </div>

            <!-- Form Nhân viên -->
            <div class="tab-pane fade" id="nhanvien" role="tabpanel">
                <form id="nhanvienForm" method="post" asp-action="SubmitNhanVienReview" asp-controller="Reviews">
                    <input type="hidden" name="IdKhachHang" value="@(User.Identity.IsAuthenticated ? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value : 0)" />

                    <div class="mb-3">
                        <label class="form-label">Tên nhân viên</label>
                        <input type="text" class="form-control rounded-3" name="TenNhanVien" placeholder="Nhập nếu bạn biết" />
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Ca làm <span class="text-danger">*</span></label>
                            <select class="form-control rounded-3" name="IdCa" required>
                                <option value="0">Chọn ca làm</option>
                                @foreach (var ca in Model.CaLams)
                                {
                                    <option value="@ca.Id">@ca.TenCa (@ca.GioLam)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Ngày làm <span class="text-danger">*</span></label>
                            <input type="date" class="form-control rounded-3" name="NgayLam" required />
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label">Ý kiến về nhân viên <span class="text-danger">*</span></label>
                        <textarea class="form-control rounded-3" name="NoiDung" rows="6" placeholder="Hãy cho chúng tôi biết cảm nhận. Nếu được mong bạn đề cập rõ thời gian để chúng tôi thuận lợi giải quyết..." required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm">Gửi ngay</button>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/a076d05399.js"></script>
    <script>
        document.getElementById('rapForm').addEventListener('submit', function(e) {
            if (!this.querySelector('textarea').value.trim()) {
                e.preventDefault();
                alert('Vui lòng nhập nội dung.');
            }
        });

        document.getElementById('nhanvienForm').addEventListener('submit', function(e) {
            const idCa = this.querySelector('select[name="IdCa"]').value;
            const noiDung = this.querySelector('textarea[name="NoiDung"]').value.trim();
            if (idCa == 0 || !noiDung) {
                e.preventDefault();
                alert('Vui lòng chọn ca làm và nhập nội dung.');
            }
        });
    </script>
}